# Optional "Play on TV" settings. Copy to tv.env (gitignored), fill in, `chmod 600 tv.env`,
# and point the compose service at it with `env_file: ./tv.env`. The feature stays off
# unless TV_HA_URL, TV_HA_TOKEN and TV_HA_ENTITY are all set.

# Home Assistant URL reachable from inside the container (host LAN IP, not localhost).
TV_HA_URL=http://192.168.1.x:8123
# Long-lived access token. A dedicated non-admin Home Assistant user is recommended.
TV_HA_TOKEN=
# The TV's media_player entity in Home Assistant (e.g. from the Apple TV integration).
TV_HA_ENTITY=media_player.living_room_tv
# Name shown in the app. Optional, defaults to "TV".
TV_NAME=Living Room TV
# Deep link the TV opens. Optional; the default plays in Rivulet (tvOS). Placeholders:
# {ratingKey} = Plex item id, {offsetMs} = resume position in milliseconds (0 = start).
# TV_URL_TEMPLATE=rivulet://play?ratingKey={ratingKey}&offset={offsetMs}
